<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <title>ورقة عمل رياضيات احترافية</title>

  <style>
    @page {
      size: A4;
      margin: 15mm 15mm 15mm 48mm;
      background-color: #ffffff;
    }

    *, *::before, *::after { box-sizing: border-box; }

    body {
      margin: 0;
      padding: 0;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      font-size: 11pt;
      color: #2d3748;
      background-color: #ffffff;
      line-height: 1.5;
    }

    /* Sidebar */
    .sidebar {
      position: absolute;
      top: -15mm;
      right: -48mm;
      width: 38mm;
      height: 297mm;
      background-color: #ffffff;
      border-left: 1px solid #cbd5e0;
      padding: 10mm 0;
      text-align: center;
    }

    .sidebar-header {
      padding: 0 5mm 10mm 5mm;
      border-bottom: 1px dashed #cbd5e0;
    }

    .main-logo-icon {
      width: 50px;
      height: 40px;
      background-color: #2f855a;
      margin: 0 auto 8px auto;
      clip-path: polygon(
        0% 20%, 45% 0%, 45% 85%, 0% 100%,
        55% 85%, 55% 0%, 100% 20%, 100% 100%,
        50% 85%, 0% 100%
      );
    }

    .sidebar-logo-text {
      color: #2f855a;
      font-size: 12pt;
      font-weight: bold;
      margin: 0;
    }

    .sidebar-subtext {
      font-size: 8pt;
      color: #718096;
      margin-top: 2px;
    }

    .sidebar-menu { margin-top: 15px; }

    .sidebar-item {
      padding: 15px 4mm;
      border-bottom: 1px dashed #cbd5e0;
    }
    .sidebar-item:last-child { border-bottom: none; }

    /* Icon base wrappers */
    .icon-box {
      width: 32px;
      height: 32px;
      margin: 0 auto 8px auto;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    /* Icons */
    .icon-book {
      background: linear-gradient(to right, #2f855a 45%, transparent 45%, transparent 55%, #2f855a 55%);
      border-radius: 4px;
      height: 20px;
      width: 26px;
    }

    .icon-users {
      position: relative;
      width: 24px;
      height: 20px;
    }
    .icon-users::before, .icon-users::after {
      content: '';
      position: absolute;
      background-color: #2f855a;
      border-radius: 50%;
    }
    .icon-users::before { width: 10px; height: 10px; top: 0; left: 7px; }
    .icon-users::after { width: 20px; height: 8px; bottom: 0; left: 2px; border-radius: 6px 6px 0 0; }

    .icon-math-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2px;
      width: 24px;
      height: 24px;
      background-color: #2f855a;
      padding: 2px;
      border-radius: 4px;
    }
    .math-dot {
      background-color: #fff;
      font-size: 7pt;
      color: #2f855a;
      font-weight: bold;
      line-height: 9px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .icon-search {
      width: 18px;
      height: 18px;
      border: 3px solid #2f855a;
      border-radius: 50%;
      position: relative;
    }
    .icon-search::after {
      content: '';
      position: absolute;
      width: 3px;
      height: 8px;
      background-color: #2f855a;
      bottom: -6px;
      left: -3px;
      transform: rotate(45deg);
    }

    .item-text {
      font-size: 8.5pt;
      color: #4a5568;
      font-weight: bold;
      line-height: 1.3;
    }

    .sidebar-badge-box {
      position: absolute;
      bottom: 15mm;
      left: 4mm;
      right: 4mm;
      border: 1px solid #ed8936;
      border-radius: 6px;
      overflow: hidden;
      text-align: center;
    }
    .badge-top {
      background-color: #ed8936;
      color: #fff;
      font-size: 8pt;
      font-weight: bold;
      padding: 3px 0;
    }
    .badge-bottom {
      background-color: #ffffff;
      color: #2d3748;
      font-size: 8.5pt;
      font-weight: bold;
      padding: 5px 0;
    }

    /* Student info */
    .student-info-table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 15px;
    }
    .student-info-table td {
      width: 33.33%;
      font-weight: bold;
      font-size: 10.5pt;
      color: #4a5568;
    }

    .dots { color: #a0aec0; }
    .t-center { text-align: center; }
    .t-left { text-align: left; }

    /* Header */
    .main-header-banner {
      background-color: #1a365d;
      color: #fff;
      padding: 10px 20px;
      border-radius: 25px;
      text-align: center;
      margin-bottom: 15px;
    }
    .main-header-title { font-size: 15pt; font-weight: bold; margin: 0; }
    .main-header-subtitle { font-size: 11pt; color: #ebf8ff; margin-top: 2px; }

    .field-banner {
      border: 1.5px solid #48bb78;
      background-color: #f0fff4;
      color: #22543d;
      padding: 6px 15px;
      border-radius: 6px;
      font-weight: bold;
      font-size: 11pt;
      margin-bottom: 20px;
      text-align: center;
    }

    /* Exercise */
    .exercise-container {
      border: 2px solid #ed8936;
      border-radius: 10px;
      padding: 20px 15px 15px 15px;
      position: relative;
      margin-bottom: 15px;
      break-inside: avoid;
      page-break-inside: avoid;
    }

    .exercise-title-badge {
      position: absolute;
      top: -14px;
      right: 20px;
      background-color: #ed8936;
      color: #fff;
      padding: 3px 15px;
      font-weight: bold;
      font-size: 11pt;
      border-radius: 20px;
    }

    .instruction-box {
      background-color: #f7fafc;
      border: 1px solid #e2e8f0;
      padding: 8px 12px;
      font-weight: bold;
      color: #2d3748;
      margin-bottom: 15px;
      border-radius: 6px;
      font-size: 10.5pt;
    }

    /* Question blocks */
    .question-block {
      border: 1px solid #e2e8f0;
      border-radius: 8px;
      margin-bottom: 12px;
      padding: 12px;
      position: relative;
      page-break-inside: avoid;
      break-inside: avoid;
    }

    .question-number {
      position: absolute;
      left: 12px;
      top: 12px;
      background-color: #ed8936;
      color: #fff;
      width: 22px;
      height: 22px;
      border-radius: 50%;
      text-align: center;
      line-height: 22px;
      font-weight: bold;
      font-size: 9.5pt;
    }

    .question-text {
      font-weight: bold;
      font-size: 11pt;
      color: #2c5282;
      margin-bottom: 8px;
      padding-right: 30px;
    }

    /* Options */
    .options-table {
      width: 100%;
      border-collapse: collapse;
    }
    .options-table td {
      padding: 6px;
      vertical-align: middle;
    }

    .checkbox-container {
      display: inline-block;
      width: 15px;
      height: 15px;
      border: 1.5px solid #4a5568;
      border-radius: 3px;
      margin-left: 6px;
      vertical-align: middle;
      background: transparent;
    }

    .option-text {
      display: inline-block;
      vertical-align: middle;
      font-size: 10.5pt;
    }

    .vertical-option-row { margin-bottom: 6px; }
    .dotted-cell { border-left: 1px dashed #cbd5e0; }

    /* Reminder */
    .reminder-box {
      background-color: #fefcbf;
      border: 1px dashed #ecc94b;
      border-radius: 8px;
      padding: 10px;
      margin-top: 15px;
      margin-bottom: 15px;
      page-break-inside: avoid;
      break-inside: avoid;
    }
    .reminder-title {
      font-weight: bold;
      color: #744210;
      font-size: 10.5pt;
    }
    .reminder-body {
      color: #744210;
      font-size: 10pt;
    }

    /* Interactive footer table */
    .interactive-table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 10px;
      page-break-inside: avoid;
      break-inside: avoid;
    }

    .interactive-box-green {
      border: 1.5px dashed #48bb78;
      background-color: #f0fff4;
      border-radius: 8px;
      padding: 10px;
      text-align: center;
      color: #22543d;
      font-weight: bold;
      font-size: 10.5pt;
    }

    .footer-credit {
      text-align: center;
      margin-top: 25px;
      color: #718096;
      font-size: 9.5pt;
      font-weight: bold;
    }
  </style>
</head>

